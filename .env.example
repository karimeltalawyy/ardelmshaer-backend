# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Public base URL used in stored PDF links (must match how browsers reach this API host)
# Prod example: PUBLIC_API_URL=https://api.example.com
PUBLIC_API_URL=http://localhost:3000

# ─── PostgreSQL ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5

# ─── WhatsApp Provider Switch ────────────────────────────────────────────────────
# Set to: meta | twilio | wapilot
WHATSAPP_PROVIDER=meta

# ─── Meta WhatsApp Cloud API ─────────────────────────────────────────────────────
# Get from: Meta for Developers > Your App > WhatsApp > API Setup
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_API_VERSION=v22.0
ADMIN_WHATSAPP_NUMBER=9665XXXXXXXX

# ─── Twilio (SMS / WhatsApp fallback) ────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_FROM=+14155238886

# ─── Wapilot (unofficial WhatsApp gateway — local pilot) ─────────────────────────
# Dashboard: https://app.wapilot.net  |  API docs: https://app.wapilot.net/api-doc/v2
# Auth is a single API token sent as the `token` header. instance_id = the instance's
# unique name (NOT the "me id" 2011...@c.us, which is just the logged-in number).
WAPILOT_BASE_URL=https://api.wapilot.net/api/v2
WAPILOT_API_TOKEN=
WAPILOT_INSTANCE_ID=

# ─── AWS S3 (File Storage) ──────────────────────────────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=transport-platform-files

# ─── Moyasar (Payments) ─────────────────────────────────────────────────────────
MOYASAR_API_KEY=sk_live_xxxxxxxxxxxx
MOYASAR_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# ─── Puppeteer / PDF (documents module + PdfService) ───────────────────────────
# Local macOS: leave empty (Puppeteer’s downloaded Chrome) or set if using system Chrome.
# Docker (this repo’s Dockerfile): CHROMIUM_PATH=/usr/bin/chromium (set automatically in image).
# Debian/Ubuntu server: e.g. CHROMIUM_PATH=/usr/bin/chromium
CHROMIUM_PATH=

# ─── Frontend CORS ──────────────────────────────────────────────────────────────
RIDER_APP_URL=http://localhost:4200
ADMIN_APP_URL=http://localhost:4201

# ─── Dev Seed (disabled by default) ─────────────────────────────────────────────
ALLOW_DEV_SEED=false
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_PASSWORD=
