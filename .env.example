# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Neon PostgreSQL ────────────────────────────────────────────────────────────
# Pooled connection — used by the running app (PgBouncer pooler URL from Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection — used by prisma migrate / db push (non-pooler URL from Neon dashboard)
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require"

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_another_long_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5

# ─── Twilio (SMS / WhatsApp) ────────────────────────────────────────────────────
# Get from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ─── AWS S3 (File Storage) ──────────────────────────────────────────────────────
AWS_REGION=me-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=transport-platform-files

# ─── Moyasar (Payments) ─────────────────────────────────────────────────────────
MOYASAR_API_KEY=sk_live_xxxxxxxxxxxx
MOYASAR_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx

# ─── Puppeteer ──────────────────────────────────────────────────────────────────
# macOS: leave empty (uses bundled Chromium)
# Ubuntu server: CHROMIUM_PATH=/usr/bin/chromium-browser
CHROMIUM_PATH=

# ─── Frontend CORS ──────────────────────────────────────────────────────────────
RIDER_APP_URL=http://localhost:4200
ADMIN_APP_URL=http://localhost:4201

# ─── Dev Seed (disabled by default) ─────────────────────────────────────────────
ALLOW_DEV_SEED=false
DEV_SEED_ADMIN_EMAIL=
DEV_SEED_ADMIN_PASSWORD=
